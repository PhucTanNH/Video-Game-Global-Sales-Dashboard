        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4B5966;strokeWidth=1.3;" edge="1" parent="1" source="engineering" target="split"><mxGeometry relative="1" as="geometry" /></mxCell>
