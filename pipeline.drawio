  <diagram id="data-processing" name="1. Data Processing and Training">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DATA PROCESSING &amp; MODEL TRAINING" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#202F3E;" vertex="1" parent="1"><mxGeometry x="80" y="35" width="1000" height="48" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Leakage-controlled workflow | VGChartz (Kaggle) video game sales" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#566575;" vertex="1" parent="1"><mxGeometry x="80" y="84" width="1000" height="30" as="geometry" /></mxCell>

        <mxCell id="n1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="95" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="raw" value="&lt;b&gt;Raw data&lt;/b&gt;&lt;br&gt;VGChartz (Kaggle)&lt;br&gt;16,327 titles&lt;br&gt;1980–2020 • 11 columns" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n2" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="clean" value="&lt;b&gt;Cleaning&lt;/b&gt;&lt;br&gt;Keep complete records&lt;br&gt;Target: log1p(Global_Sales)&lt;br&gt;Inverse transform: expm1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="845" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="engineering" value="&lt;b&gt;Feature engineering&lt;/b&gt;&lt;br&gt;9 groups (A–I) • 65 engineered&lt;br&gt;27 modelled: 6 categorical&lt;br&gt;+ 21 numeric features&lt;br&gt;Backward-looking only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="split" value="&lt;b&gt;Time split&lt;/b&gt;&lt;br&gt;Train: ≤ 2012&lt;br&gt;14,237 titles&lt;br&gt;Test: ≥ 2013 • 2,090 titles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="tuning" value="&lt;b&gt;CV and model selection&lt;/b&gt;&lt;br&gt;Training set only&lt;br&gt;5 outer temporal folds&lt;br&gt;Stack OOF: 3 chronological folds&lt;br&gt;Reported tuned configs; search space unavailable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1205" y="615" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="845" y="560" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="zoo" value="&lt;b&gt;Model zoo&lt;/b&gt;&lt;br&gt;Linear, Ridge, kNN, Random Forest&lt;br&gt;XGBoost, LightGBM, CatBoost&lt;br&gt;Stacking → Ridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="615" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="evaluation" value="&lt;b&gt;Retrospective holdout&lt;/b&gt;&lt;br&gt;2013–2020 • 2,090 titles&lt;br&gt;Selected XGBoost: RMSE 0.970M&lt;br&gt;MAE 0.372M • R² 0.389&lt;br&gt;Holdout reused during development" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="615" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="95" y="560" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="analysis" value="&lt;b&gt;Analysis and export&lt;/b&gt;&lt;br&gt;Permutation importance&lt;br&gt;Ablations (RQ3–RQ6)&lt;br&gt;Error analysis • export best model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="615" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4B5966;strokeWidth=1.3;" edge="1" parent="1" source="raw" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell>
