        <mxCell id="title" value="INPUT &amp; SALES PREDICTION" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#202F3E;" vertex="1" parent="1"><mxGeometry x="80" y="35" width="1000" height="48" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Streamlit inference workflow | Global sales in millions of units" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#566575;" vertex="1" parent="1"><mxGeometry x="80" y="84" width="1000" height="30" as="geometry" /></mxCell>

        <mxCell id="n1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="95" y="150" width="38" height="38" as="geometry" /></mxCell>
