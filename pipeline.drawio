        <mxCell id="lookup" value="&lt;b&gt;Data lookup&lt;/b&gt;&lt;br&gt;Game dataset (Excel)&lt;br&gt;Recent 3-year sales&lt;br&gt;Platform and publisher metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="845" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="features" value="&lt;b&gt;Feature engineering&lt;/b&gt;&lt;br&gt;Model input vector&lt;br&gt;6 categorical + 21 numeric features&lt;br&gt;Rolling and prior-year cumulative stats" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="range-check" value="&lt;b&gt;Range check&lt;/b&gt;&lt;br&gt;Compare with training ranges&lt;br&gt;Warn for out-of-range inputs&lt;br&gt;Warn when year &amp;gt; 2016" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="205" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="38" height="38" as="geometry" /></mxCell>
        <mxCell id="prediction" value="&lt;b&gt;Prediction&lt;/b&gt;&lt;br&gt;best_model.joblib&lt;br&gt;Tuned XGBoost • selected by CV&lt;br&gt;27 inputs • Global sales (M)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="615" width="270" height="145" as="geometry" /></mxCell>

        <mxCell id="n6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#287FB5;strokeColor=#287FB5;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="845" y="560" width="38" height="38" as="geometry" /></mxCell>
