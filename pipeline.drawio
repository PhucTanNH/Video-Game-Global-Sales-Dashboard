        <mxCell id="error-band" value="&lt;b&gt;Error band&lt;/b&gt;&lt;br&gt;Prediction ± 1.96 × test MAE&lt;br&gt;Selected-model MAE = 0.372M&lt;br&gt;Approximate, not calibrated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#677786;strokeWidth=1;fontColor=#263746;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="615" width="270" height="145" as="geometry" /></mxCell>

